# Public Supabase configuration is in web/config.mjs; no service-role key is used.
# Enable only after choosing a live Gateway model and approving a budget.
AI_GENERATIVE_ENABLED=false
AI_GATEWAY_MODEL=
# Comma-separated Supabase user UUIDs authorized for the pilot.
AI_ALLOWED_USER_IDS=
# Vercel uses its OIDC automatically. Local development only:
AI_GATEWAY_API_KEY=
